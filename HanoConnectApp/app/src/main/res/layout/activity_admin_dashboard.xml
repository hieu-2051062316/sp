<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F0F2F5"
    tools:context=".AdminDashboardActivity">

    <TextView
        android:id="@+id/tvAdminDashboardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quản Trị Hệ Thống"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản Lý Người Dùng"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageVolunteers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý Tình nguyện viên"
                app:cornerRadius="8dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageOrganizations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý Tổ chức"
                app:cornerRadius="8dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyOrganizations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xác thực Tổ chức mới"
                app:cornerRadius="8dp"
                android:padding="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản Lý Nội Dung &amp; Danh Mục"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageOpportunities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kiểm duyệt Cơ hội Tình nguyện"
                app:cornerRadius="8dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý Kỹ năng &amp; Lĩnh vực"
                app:cornerRadius="8dp"
                android:padding="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem Báo cáo Thống kê"
        app:cornerRadius="8dp"
        android:padding="12dp" />

</LinearLayout>