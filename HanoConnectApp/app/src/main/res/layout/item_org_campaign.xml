<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCampaignLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/logo_hanoconnect" />

        <TextView
            android:id="@+id/tvCampaignName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivCampaignLogo"
            app:layout_constraintTop_toTopOf="@+id/ivCampaignLogo"
            tools:text="Mùa Hè Xanh 2025" />

        <TextView
            android:id="@+id/tvCampaignStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tvCampaignName"
            app:layout_constraintStart_toStartOf="@+id/tvCampaignName"
            app:layout_constraintTop_toBottomOf="@+id/tvCampaignName"
            tools:text="Có 123 đơn ứng tuyển" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewApplicants"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:text="Xem đơn"
            app:layout_constraintEnd_toStartOf="@+id/btnEditCampaign"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivCampaignLogo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditCampaign"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa"
            app:layout_constraintBottom_toBottomOf="@+id/btnViewApplicants"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnViewApplicants" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>